# =============================================================================
# Viralix Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit real secrets to version control.
# =============================================================================

# === APPLICATION ===
APP_TITLE="Main API v3"
APP_VERSION=3.0.0
WORKER_ID=worker-1
WORKER_MAX_CONCURRENT_TASKS=30
ALLOWED_ORIGINS=["*"]

# === AUTHENTICATION ===
# Firebase service account (JSON file path inside container)
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
FIREBASE_PHANTOM_EMAIL_DOMAIN=example.com
# Internal key for bot-to-server authentication
BOT_SECRET_KEY=change-me-to-a-random-string
# Telegram bot token for notifications
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# === DATABASE (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/viralix

# === REDIS ===
REDIS_URL=redis://:password@localhost:6379/0

# === YANDEX OBJECT STORAGE (S3-compatible) ===
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET_NAME=viralix-media
YANDEX_REGION=ru-central1
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# === YANDEX MESSAGE QUEUE (SQS-compatible) ===
YANDEX_QUEUE_REGION=ru-central1
YANDEX_QUEUE_ENDPOINT=https://message-queue.api.cloud.yandex.net
YANDEX_QUEUE_URL=
YANDEX_DLQ_URL=
YANDEX_SQS_ACCESS_KEY_ID=
YANDEX_SQS_SECRET_ACCESS_KEY=

# === AI PROVIDERS ===
# GrsAI (primary provider for video/image generation)
GRSAI_API_KEY=
# Unificantly (fallback for Sora video)
API_UNIFICALLY_TOKEN=
# OpenAI (fallback for Sora video)
OPENAI_API_KEY=
# Additional LLM providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Legacy Kie AI provider
KIE_AI=

# === GETCOURSE INTEGRATION ===
GETCOURSE_API_KEY=
GETCOURSE_ACCOUNT_NAME=
GETCOURSE_ADMIN_EMAIL=
GETCOURSE_WEBHOOK_SECRET=change-me-to-a-random-string
FRONTEND_DOMAIN=

# === CIRCUIT BREAKER ===
CIRCUIT_BREAKER_TTL=300

# === REFERRAL SYSTEM ===
# Change this to a unique random string for your deployment
REFERRAL_SALT=change-me-to-a-random-unique-salt
