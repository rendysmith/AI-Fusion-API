# .env.example
# Это шаблон настроек для локальной разработки.
# Скопируй этот файл в .env и заполни секреты.

# === СЕКРЕТЫ ПРИЛОЖЕНИЯ ===
# Секретный ключ для Telegram-бота (должен совпадать с ключом бота)
BOT_SECRET_KEY=
# Ключ для Kie AI
KIE_AI=
# Ключ для OpenAI (Fallback)
OPENAI_API_KEY=

# === НАСТРОЙКИ POSTGRES (Локальный Docker) ===
POSTGRES_DB=main_api_db
POSTGRES_USER=random
POSTGRES_PASSWORD=random_password_please_change
POSTGRES_HOST=db
POSTGRES_PORT=5432

# (Собирается автоматически)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === НАСТРОЙКИ REDIS / VALKEY (Локальный Docker) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=my_super_secret_redis_password
REDIS_DB=0

# (Собирается автоматически)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# === НАСТРОЙКИ S3 (Эмулятор MinIO) ===
# Для Yandex в production:
# YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# S3_PUBLIC_ENDPOINT=https://<имя-бакета>.storage.yandexcloud.net
YANDEX_STORAGE_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
YANDEX_ACCESS_KEY_ID=minioadmin
YANDEX_SECRET_ACCESS_KEY=minioadmin
YANDEX_BUCKET_NAME=local-bucket
YANDEX_REGION=ru-central1

# === НАСТРОЙКИ SQS (Эмулятор ElasticMQ) ===
# Для Yandex в production:
# YANDEX_QUEUE_ENDPOINT=https://message-queue.api.cloud.yandex.net
# YANDEX_QUEUE_URL=https://message-queue.api.cloud.yandex.net/<id>/<id>/<имя>
# YANDEX_DLQ_URL=https://message-queue.api.cloud.yandex.net/<id>/<id>/<имя_dlq>
YANDEX_QUEUE_ENDPOINT=http://elasticmq:9324
YANDEX_QUEUE_REGION=ru-central1
YANDEX_QUEUE_URL=http://elasticmq:9324/000000000000/general_tasks_queue
YANDEX_DLQ_URL=http://elasticmq:9324/000000000000/general_tasks_queue-dlq

# (Для ElasticMQ оставляем "x", для Yandex нужны реальные ключи)
YANDEX_SQS_ACCESS_KEY_ID="x"
YANDEX_SQS_SECRET_ACCESS_KEY="x"

# === НАСТРОЙКИ FIREBASE ===
# Путь к ключу ВНУТРИ контейнера (файл прокидывается через docker-compose)
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# Домен для "фантомных" email-ов (вход через TG)
FIREBASE_PHANTOM_EMAIL_DOMAIN=users.my-ai-service.com

# === НАСТРОЙКИ ВОРКЕРА ===
WORKER_ID=local-worker-1
# Время жизни "тумблера" (Circuit Breaker) в секундах
CIRCUIT_BREAKER_TTL=300